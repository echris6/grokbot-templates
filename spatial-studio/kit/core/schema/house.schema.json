{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/echris6/grokbot-templates/spatial-studio/kit/core/schema/house.schema.json",
 "title": "Spatial Studio house spec",
 "description": "One house (or unit) as data. Units: metres. Plan coordinates: x to the right (east), y DOWN the plan (south), like the plan image; wall centrelines. Heights are above the level's floor. Furniture rotation is clockwise on the plan in degrees; 0 = the item's front faces +y (down the plan). `facing` (N/S/E/W) overrides rotation. Viewpoint position/target are [x, y, height].",
 "type": "object",
 "required": [
  "version",
  "meta",
  "levels"
 ],
 "additionalProperties": true,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "version": {
   "const": 1
  },
  "meta": {
   "type": "object",
   "required": [
    "name"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "fictional": {
     "type": "boolean",
     "description": "true for demo/sample houses that are not real properties"
    },
    "label": {
     "type": "string",
     "description": "badge shown in the page header, e.g. 'Unsolicited sample \u00b7 made from your public materials'"
    },
    "units": {
     "const": "m"
    },
    "source_plan": {
     "type": "string",
     "description": "path or URL of the floor plan this spec was read from"
    },
    "source_url": {
     "type": "string"
    },
    "stated_area_m2": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "stated_area_sqft": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "stated_area_basis": {
     "type": "string",
     "description": "what the plan's area figure measures, e.g. 'gross, to the outside face of exterior walls' or 'living area, heated only'"
    },
    "north_deg": {
     "type": "number",
     "description": "compass bearing of plan-up; 0 = plan up is north"
    },
    "notes": {
     "type": "string"
    }
   }
  },
  "defaults": {
   "type": "object",
   "properties": {
    "wall_height": {
     "type": "number",
     "minimum": 1.8,
     "maximum": 6
    },
    "wall_thickness": {
     "type": "number",
     "minimum": 0.05,
     "maximum": 0.6
    },
    "exterior_wall_thickness": {
     "type": "number",
     "minimum": 0.08,
     "maximum": 0.8
    },
    "eye_height": {
     "type": "number",
     "minimum": 1.2,
     "maximum": 2
    },
    "floor": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "wall": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "ceiling": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "exterior_wall": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "trim": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "wall_cut": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "skirting_height": {
     "type": "number"
    }
   }
  },
  "materials": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/definitions/material"
   }
  },
  "render": {
   "type": "object",
   "description": "lighting/look overrides",
   "properties": {
    "sun_azimuth_deg": {
     "type": "number"
    },
    "sun_elevation_deg": {
     "type": "number",
     "minimum": 5,
     "maximum": 85
    },
    "sun_intensity": {
     "type": "number"
    },
    "sun_color": {
     "type": "string"
    },
    "env_intensity": {
     "type": "number"
    },
    "hemi_intensity": {
     "type": "number"
    },
    "exposure": {
     "type": "number"
    },
    "shadow_map": {
     "type": "integer"
    },
    "sky_top": {
     "type": "string"
    },
    "sky_horizon": {
     "type": "string"
    },
    "sky_ground": {
     "type": "string"
    }
   }
  },
  "site": {
   "type": "object",
   "properties": {
    "ground": {
     "type": "boolean"
    },
    "ground_material": {
     "oneOf": [
      {
       "type": "string",
       "description": "a name from materials (or the built-ins), or a #hex colour"
      },
      {
       "$ref": "#/definitions/material"
      }
     ]
    },
    "trees": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
     }
    }
   }
  },
  "levels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/level"
   }
  },
  "viewpoints": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/viewpoint"
   }
  },
  "scale_checks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "plan_value_m",
     "measure"
    ],
    "properties": {
     "label": {
      "type": "string"
     },
     "plan_value_m": {
      "type": "number"
     },
     "measure": {
      "type": "object",
      "required": [
       "kind"
      ],
      "properties": {
       "kind": {
        "enum": [
         "overall_x",
         "overall_y",
         "room_x",
         "room_y",
         "room_clear_x",
         "room_clear_y",
         "wall_length",
         "opening_width"
        ]
       },
       "room": {
        "type": "string"
       },
       "wall": {
        "type": "string"
       },
       "opening": {
        "type": "string"
       },
       "level": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 },
 "definitions": {
  "point": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "material": {
   "type": "object",
   "properties": {
    "color": {
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "roughness": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "metalness": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "pattern": {
     "enum": [
      "planks",
      "tiles",
      "carpet",
      "stone",
      "plaster",
      "grass",
      "fabric",
      "none"
     ]
    },
    "texture": {
     "type": "string",
     "description": "image path relative to the spec file (e.g. a crop of the builder's photo of the floor)"
    },
    "texture_size_m": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "plank_width": {
     "type": "number"
    },
    "plank_length": {
     "type": "number"
    },
    "tile_size_m": {
     "oneOf": [
      {
       "type": "number"
      },
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     ]
    },
    "grout_color": {
     "type": "string"
    },
    "stagger": {
     "type": "boolean"
    },
    "rotate_deg": {
     "type": "number"
    },
    "opacity": {
     "type": "number"
    },
    "emissive": {
     "type": "string"
    },
    "emissive_intensity": {
     "type": "number"
    },
    "vein_color": {
     "type": "string"
    },
    "tone_var": {
     "type": "number"
    }
   }
  },
  "level": {
   "type": "object",
   "required": [
    "id",
    "rooms",
    "walls"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "elevation": {
     "type": "number"
    },
    "height": {
     "type": "number"
    },
    "rooms": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "name",
       "polygon"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9-_]+$"
       },
       "name": {
        "type": "string"
       },
       "polygon": {
        "type": "array",
        "minItems": 3,
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        }
       },
       "floor": {
        "oneOf": [
         {
          "type": "string",
          "description": "a name from materials (or the built-ins), or a #hex colour"
         },
         {
          "$ref": "#/definitions/material"
         }
        ]
       },
       "wall": {
        "oneOf": [
         {
          "type": "string",
          "description": "a name from materials (or the built-ins), or a #hex colour"
         },
         {
          "$ref": "#/definitions/material"
         }
        ]
       },
       "ceiling": {
        "oneOf": [
         {
          "type": "string",
          "description": "a name from materials (or the built-ins), or a #hex colour"
         },
         {
          "$ref": "#/definitions/material"
         }
        ]
       },
       "ceiling_height": {
        "type": "number"
       },
       "skirting": {
        "type": "boolean"
       },
       "label_at": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      }
     }
    },
    "walls": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "a",
       "b"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "a": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       },
       "b": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       },
       "exterior": {
        "type": "boolean"
       },
       "thickness": {
        "type": "number",
        "minimum": 0.04,
        "maximum": 1
       },
       "height": {
        "type": "number"
       }
      }
     }
    },
    "openings": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "wall",
       "type",
       "offset"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "wall": {
        "type": "string"
       },
       "type": {
        "enum": [
         "door",
         "window",
         "opening",
         "sliding"
        ]
       },
       "offset": {
        "type": "number",
        "description": "distance from the wall's `a` end to the CENTRE of the opening"
       },
       "width": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "height": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "sill": {
        "type": "number",
        "minimum": 0
       },
       "hinge": {
        "enum": [
         "a",
         "b"
        ]
       },
       "swing": {
        "enum": [
         "+",
         "-"
        ],
        "description": "side of the wall the door swings into; + = the wall's left normal (-dy, dx)"
       },
       "open_deg": {
        "type": "number",
        "minimum": 0,
        "maximum": 120
       },
       "exterior_door": {
        "type": "boolean"
       },
       "color": {
        "type": "string"
       },
       "frame_color": {
        "type": "string"
       },
       "panes": {
        "type": "integer",
        "minimum": 1
       },
       "frosted": {
        "type": "boolean"
       },
       "curtains": {
        "type": "boolean"
       },
       "curtain_color": {
        "type": "string"
       },
       "inside_side": {
        "enum": [
         1,
         -1
        ]
       },
       "casing": {
        "type": "boolean"
       },
       "panels": {
        "type": "boolean"
       }
      }
     }
    },
    "furniture": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "type",
       "position",
       "size"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "type": {
        "enum": [
         "bed",
         "nightstand",
         "sofa",
         "armchair",
         "coffee_table",
         "table",
         "desk",
         "chair",
         "stool",
         "counter",
         "island",
         "cabinet",
         "dresser",
         "wardrobe",
         "shelving",
         "fridge",
         "bathtub",
         "shower",
         "toilet",
         "vanity",
         "rug",
         "lamp",
         "media_unit",
         "plant",
         "console",
         "bench",
         "art",
         "box"
        ]
       },
       "room": {
        "type": "string"
       },
       "position": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       },
       "size": {
        "type": "array",
        "items": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "minItems": 2,
        "maxItems": 3,
        "description": "[width, depth, height] in the item's own frame"
       },
       "rotation": {
        "type": "number"
       },
       "facing": {
        "enum": [
         "N",
         "S",
         "E",
         "W"
        ]
       },
       "elevation": {
        "type": "number",
        "minimum": 0
       },
       "material": {
        "type": "string"
       },
       "color": {
        "type": "string"
       },
       "accent": {
        "type": "string"
       },
       "collide": {
        "type": "boolean"
       },
       "photo_ref": {
        "type": "string",
        "description": "which reference photo this item was matched to"
       }
      }
     }
    },
    "lights": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "room",
       "position"
      ],
      "properties": {
       "room": {
        "type": "string"
       },
       "type": {
        "enum": [
         "ceiling",
         "pendant"
        ]
       },
       "position": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       },
       "drop": {
        "type": "number"
       },
       "radius": {
        "type": "number"
       },
       "intensity": {
        "type": "number"
       },
       "distance": {
        "type": "number"
       },
       "color": {
        "type": "string"
       },
       "emit": {
        "type": "boolean"
       },
       "shade_color": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "viewpoint": {
   "type": "object",
   "required": [
    "id",
    "position",
    "target"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9-_]+$"
    },
    "room": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "level": {
     "type": "string"
    },
    "position": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "target": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "fov": {
     "type": "number",
     "minimum": 30,
     "maximum": 100,
     "description": "vertical field of view, degrees"
    },
    "photo": {
     "type": [
      "string",
      "null"
     ],
     "description": "the client's reference photo this viewpoint must match (path relative to the spec)"
    }
   }
  }
 }
}